# Copy this file to .env and fill in the values. .env is never committed.

# Supabase "session pooler" connection string (see docs/schema.md)
DATABASE_URL=

# Django secret key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# and paste it between single quotes, because it can contain symbols.
SECRET_KEY=

# Set to True for local development; leave unset (off) anywhere else.
DEBUG=
